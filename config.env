# AWS Configuration
export AWS_ACCESS_KEY_ID=your_access_key_here
export AWS_SECRET_ACCESS_KEY=your_secret_key_here
export AWS_DEFAULT_REGION=us-east-1
export AWS_S3_ENDPOINT=s3.amazonaws.com

# S3 Paths
export S3_INPUT_PATH=s3a://your-input-bucket/streaming-data/
export CHECKPOINT_LOCATION=s3a://your-checkpoint-bucket/checkpoints/streaming-app/
export ICEBERG_WAREHOUSE=s3a://your-iceberg-warehouse/

# Application Configuration
export ICEBERG_TABLE_NAME=streaming_events
export TRIGGER_INTERVAL=30 seconds

# Spark Configuration
export SPARK_HOME=/opt/spark
export PYTHONPATH=$SPARK_HOME/python:$SPARK_HOME/python/lib/py4j-0.10.9-src.zip:$PYTHONPATH
export PATH=$SPARK_HOME/bin:$PATH